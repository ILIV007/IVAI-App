        S[Screenshot & semantics matrix]
        T --> C --> S
    end

    subgraph Core[Phase 7.1 — Core Experience]
        N[Adaptive navigation\nbottom bar · rail · panes]
        H[Chat workspace\ncontext + session drawer + composer]
        N --> H
    end

    subgraph Connections[Phase 7.2 — User-managed Connections]
        P[Provider setup\nfamily → trust → credential → model]
        R[Combo builder\nordered user-defined fallback]
        P --> R
    end

    subgraph Agent[Phase 7.3 — Bounded Agent]
        A[Profile library]
        W[Live run workspace\ntimeline · trace · cancel]
        Q[Allow-once approval sheet]
        A --> W --> Q
    end

    subgraph Finish[Phase 7.4–7.5 — Complete & Validate]
        X[Project Hub + Settings polish]
        U[Card sort · tree test · moderated tasks]
        G[Accessibility + device hardening]
        X --> U --> G
    end

    Foundation --> Core --> Connections --> Agent --> Finish

    I[Non-negotiable invariants\nLocal-first · Backendless · BYOK · explicit control]
